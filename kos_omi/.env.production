# ==============================================================================
# KOS OMI - PRODUCTION ENVIRONMENT CONFIGURATION (.env.production)
# Task 3.9 Production Build & Deployment (PRD Bab 7, Bab 11, Bab 12)
# ==============================================================================

# ===== APLIKASI PRODUKSI =====
NEXT_PUBLIC_APP_URL=https://kosomi.id
NODE_ENV=production

# ===== DATABASE (Neon Serverless PostgreSQL - Production Branch) =====
DATABASE_URL=postgresql://kosomi_admin:YOUR_PRODUCTION_DB_PASSWORD@ep-kosomi-prod.ap-southeast-1.aws.neon.tech/kosomi_production?sslmode=require

# ===== AUTENTIKASI (Auth.js v5 / NextAuth Production) =====
AUTH_SECRET=b63c78d492fa2f567b561c28b6d85a06e93ff7900b17ec1e9a2bca88371234ef
AUTH_URL=https://kosomi.id
AUTH_TRUST_HOST=true

# ===== GATEWAY PEMBAYARAN: MIDTRANS PRODUCTION (PRD Bab 7 & Task 3.9) =====
# Mode produksi aktif: Menggunakan endpoint resmi app.midtrans.com & api.midtrans.com
MIDTRANS_IS_PRODUCTION=true
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=true
MIDTRANS_SERVER_KEY=Mid-server-YOUR_PRODUCTION_SERVER_KEY
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=Mid-client-YOUR_PRODUCTION_CLIENT_KEY
NEXT_PUBLIC_MIDTRANS_SNAP_JS_URL=https://app.midtrans.com/snap/snap.js
MIDTRANS_SNAP_BASE_URL=https://app.midtrans.com
MIDTRANS_CORE_BASE_URL=https://api.midtrans.com

# Webhook URL resmi terdaftar di Midtrans MAP (Merchant Administration Portal):
MIDTRANS_WEBHOOK_URL=https://kosomi.id/api/webhooks/midtrans

# ===== NOTIFIKASI EMAIL (Resend Production Domain Terverifikasi) =====
RESEND_API_KEY=re_prod_YOUR_VERIFIED_DOMAIN_API_KEY
EMAIL_FROM="Kos Omi <noreply@kosomi.id>"

# ===== NOTIFIKASI WHATSAPP (Fonnte Production Multi-device) =====
WHATSAPP_PROVIDER=fonnte
WHATSAPP_API_URL=https://api.fonnte.com/send
WHATSAPP_API_TOKEN=YOUR_PRODUCTION_FONNTE_TOKEN
WHATSAPP_SENDER_NUMBER=6281234567890

# ===== PENYIMPANAN BERKAS PRIVAT (Vercel Blob Storage - KTP & Dokumen) =====
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_YOUR_PRODUCTION_TOKEN

# ===== RATE LIMITER & DISTRIBUTED LOCK (Upstash Redis Production) =====
UPSTASH_REDIS_REST_URL=https://kosomi-redis-prod.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_PROD_UPSTASH_REST_TOKEN

# ===== JOB TERJADWAL OTOMATIS (Vercel Cron Secret Authentication) =====
CRON_SECRET=cf8290ab94e038891176e5d956bf3a07297eefb2046bc34091a1d9ec34927e12

# ===== PENGATURAN OPERASIONAL BISNIS KOS OMI =====
DEFAULT_DUE_DAY=5
DEFAULT_DEPOSIT_PERCENT=100
BOOKING_PAYMENT_WINDOW_HOURS=24
TIMEZONE=Asia/Jakarta
